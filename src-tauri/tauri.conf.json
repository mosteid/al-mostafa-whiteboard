{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "منصة الأستاذ مصطفى عيد",
  "version": "3.0.0",
  "identifier": "com.mostafaeid.board",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "منصة الأستاذ مصطفى عيد الصافي - معلم اللغة العربية",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "منصة الأستاذ مصطفى عيد",
    "longDescription": "سبورة تفاعلية وقارئ PDF للأستاذ مصطفى عيد الصافي - معلم اللغة العربية",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}